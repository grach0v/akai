# Robot meshes and textures: large and effectively binary, kept in Git LFS.
# MJCF/URDF models, scene YAML and generators stay in plain git (small, diffable).
# A clone without git-lfs gets pointer files instead, and MuJoCo fails to parse them.
assets/**/*.stl filter=lfs diff=lfs merge=lfs -text
assets/**/*.STL filter=lfs diff=lfs merge=lfs -text
assets/**/*.obj filter=lfs diff=lfs merge=lfs -text
assets/**/*.dae filter=lfs diff=lfs merge=lfs -text
assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
