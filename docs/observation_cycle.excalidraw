  {
   "id": "text-67",
   "type": "text",
   "x": 654,
   "y": 1097,
   "width": 1172,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 818661758,
   "version": 1,
   "versionNonce": 289255806,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "target_t answers obs_t, so it carries obs_t's step; the teleop clock only sets what the next answer holds.\nThe two clocks can run at any rates, on any machines. safety gets obs_t and target_t of one step, joined\nby sync. A policy fits the web controller's slot: on obs_t, it sends action_t.\nmetadata: step (sync numbers obs_t, every answer copies it), capture_time, names (one label per value)",
   "originalText": "target_t answers obs_t, so it carries obs_t's step; the teleop clock only sets what the next answer holds.\nThe two clocks can run at any rates, on any machines. safety gets obs_t and target_t of one step, joined\nby sync. A policy fits the web controller's slot: on obs_t, it sends action_t.\nmetadata: step (sync numbers obs_t, every answer copies it), capture_time, names (one label per value)",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  }
